# CONFIG
# Espone la documentazione delle API su /api-docs. Lasciare vuoto in produzione.
SWAGGER_ENABLED=

# APP
BASE_URL=
REACT_APP_BASE_URL=
PORT=

# DATABASE
DB_HOST=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# EMAIL
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=

# SECURITY
JWT_SECRET=

# HTTPS
HTTPS=
HTTPS_PRIVATEKEY=
HTTPS_CERTIFICATE=

# FIREBASE
# Percorso del file della service account, tenuto fuori dal repository.
GOOGLE_APPLICATION_CREDENTIALS=

# QUICKNODE
QUICKNODE_IS_ACTIVE=
QUICKNODE_API_KEY=

QUICKNODE_BTC_TEST_URL=
QUICKNODE_BTC_TEST_EXPLORER_URL=
QUICKNODE_ETH_TEST_URL=
QUICKNODE_ETH_TEST_EXPLORER_URL=
QUICKNODE_BNB_TEST_URL=
QUICKNODE_BNB_TEST_EXPLORER_URL=
QUICKNODE_SOL_TEST_URL=
QUICKNODE_SOL_TEST_EXPLORER_URL=

QUICKNODE_BTC_MAIN_URL=
QUICKNODE_BTC_MAIN_EXPLORER_URL=
QUICKNODE_ETH_MAIN_URL=
QUICKNODE_ETH_MAIN_EXPLORER_URL=
QUICKNODE_BNB_MAIN_URL=
QUICKNODE_BNB_MAIN_EXPLORER_URL=
QUICKNODE_SOL_MAIN_URL=
QUICKNODE_SOL_MAIN_EXPLORER_URL=

# RPC
ETH_TEST_URL=
ETH_MAIN_URL=
BNB_TEST_URL=
BNB_MAIN_URL=
BITCORE_TEST_URL=
BITCORE_MAIN_URL=
SOL_TEST_URL=
SOL_MAIN_URL=

# WEBHOOK
# Il segreto e' il security token generato dal provider. SCHEME indica cosa
# viene firmato: raw per l'HMAC del solo corpo, quicknode per la concatenazione
# di nonce, timestamp e corpo che usa Quicknode Streams. Senza segreto o senza
# header la rotta risponde 503: un webhook non verificato non viene accettato.
QUICKNODE_WEBHOOK_SECRET=
QUICKNODE_WEBHOOK_SIGNATURE_HEADER=x-qn-signature
QUICKNODE_WEBHOOK_ALGORITHM=sha256
QUICKNODE_WEBHOOK_SCHEME=quicknode
QUICKNODE_WEBHOOK_TOLERANCE_MS=

# MORALIS
MORALIS_ERC20_TOKEN_URL=
MORALIS_API_KEY=

# COIN GECKO
COIN_GECKO_COIN_PRICE_URI=
COIN_GECKO_API_KEY=
COIN_GECKO_CACHE_INTERVAL=

# COINPAPRIKA
COINPAPRIKA_BASE_URL=
COINPAPRIKA_USERNAME=
COINPAPRIKA_PASSWORD=

# RANGO
RANGO_API_KEY=
RANGO_REFERRER_ADDRESS=
RANGO_REFERRER_FEE=

# WALLET CONNECT
WALLET_CONNECT_API_KEY=

# PANNELLO DI MONITORAGGIO (/admin)
# Spento se ADMIN_PANEL_ENABLED non vale esattamente "true": le rotte non
# vengono montate e /admin non esiste. Se e' acceso, il server rifiuta di
# partire quando una di queste variabili manca o non ha senso.
# ADMIN_PASSWORD_HASH e ADMIN_JWT_SECRET si generano con `npm run admin:hash`.
# ADMIN_JWT_SECRET deve essere diverso da JWT_SECRET, altrimenti un token del
# pannello e uno di dispositivo non sarebbero piu' distinguibili.
ADMIN_PANEL_ENABLED=false
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
# Durata della sessione; predefinita 30m.
ADMIN_SESSION_TTL=30m
# Consente alla consolle di prova i metodi che modificano o cancellano dati.
# Nasce spento: la capacita' c'e' quando serve, non per distrazione.
ADMIN_PROBE_DESTRUCTIVE=false
